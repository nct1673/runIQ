# RunIQ settings. Copy to `.env` and edit. For the Docker setup the only
# required value is AUTH_PASSWORD; everything else is optional.

# --- Login (required) -------------------------------------------------------
# The password you log in with. It is read once, on the very first start, and
# stored hashed in the database. Change it later from inside the app (editing
# this file afterwards has no effect).
AUTH_PASSWORD=
# Login email (single user). Leave as is unless you want a different one.
DEFAULT_USER_EMAIL=owner@runiq.local

# --- Optional integrations ---------------------------------------------------
OPENWEATHER_API_KEY=
# Garmin Connect (unofficial API via python-garminconnect)
GARMIN_EMAIL=
GARMIN_PASSWORD=

# --- AI Coach ----------------------------------------------------------------
#   gemini = Google Gemini API (needs GEMINI_API_KEY)
#   ollama = local model, run with: docker compose --profile ollama up -d
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OLLAMA_CHAT_MODEL=qwen3:14b
OLLAMA_EMBED_MODEL=nomic-embed-text
# Ollama running on your host instead of the compose profile:
# OLLAMA_URL=http://host.docker.internal:11434

# --- Docker stack options (all optional) ---------------------------------------
# RUNIQ_PORT=3000
# POSTGRES_PASSWORD=runiq   # letters/digits only; set before the first start

# --- Only for running the backend outside Docker (conda) -----------------------
# Docker generates these itself. Outside Docker you must provide them.
# DATABASE_URL=postgresql+psycopg2://runiq:runiq@localhost:5432/runiq
# SESSION_SECRET_KEY=
# COACH_DB_PASSWORD=
# OLLAMA_BASE_URL=http://localhost:11434
