# Database (matches docker-compose defaults; override for a local, non-Docker Postgres)
DATABASE_URL=postgresql+psycopg2://runiq:runiq@localhost:5432/runiq

# Single-user identity -- also the login email (blueprint §4)
DEFAULT_USER_EMAIL=

# Weather (blueprint Module 1/2)
OPENWEATHER_API_KEY=

# Garmin Connect (unofficial API via python-garminconnect)
GARMIN_EMAIL=
GARMIN_PASSWORD=

# Login module -- single-user access gate
SESSION_SECRET_KEY=
AUTH_PASSWORD=

# AI Coach (blueprint Module 6) -- Ollama, local/GPU-hosted
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:14b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
