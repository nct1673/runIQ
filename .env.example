# Database (matches docker-compose defaults; override for a local, non-Docker Postgres)
DATABASE_URL=postgresql+psycopg2://runiq:runiq@localhost:5432/runiq

# Weather / Air Quality (blueprint Module 1/2)
OPENWEATHER_API_KEY=
GOOGLE_AIR_QUALITY_API_KEY=

# Garmin Connect (unofficial API via python-garminconnect)
GARMIN_EMAIL=
GARMIN_PASSWORD=

# AI Coach (blueprint Module 6)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
